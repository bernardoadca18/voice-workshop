KOKORO_API_KEY=
KOKORO_VOICE=pm_alex

# Pós-processamento final da narração (não afeta datasets de treinamento)
AUDIO_TARGET_LUFS=-16.0
AUDIO_MAX_TRUE_PEAK_DB=-1.0
AUDIO_TRUE_PEAK_TOLERANCE_DB=0.02
AUDIO_TRUE_PEAK_SAFETY_MARGIN_DB=0.05
AUDIO_MIN_ACCEPTABLE_LUFS=-18.0
AUDIO_MAX_ACCEPTABLE_LUFS=-15.0
# Estabilidade para execução em batch
MAX_QUEUED_JOBS=100
MAX_RETAINED_JOBS=1000
SEEDVC_TIMEOUT_S=600
SEEDVC_MAX_CACHED_MODELS=1
SEEDVC_CPU_THREADS=2
SEEDVC_INFERENCE_LOCK_TIMEOUT_S=900
SEEDVC_DIFFUSION_STEPS_DRAFT=35
SEEDVC_DIFFUSION_STEPS_FINAL=75
AUDIO_TARGET_DBFS=-20.0

# Limites de segurança dos containers (ajuste conforme o host)
SEEDVC_MEMORY_LIMIT=5g
SEEDVC_CPU_LIMIT=4.0
KOKORO_MEMORY_LIMIT=2500m
KOKORO_CPU_LIMIT=4.0
ORCHESTRATOR_MEMORY_LIMIT=768m
ORCHESTRATOR_CPU_LIMIT=2.0
MALLOC_ARENA_MAX=2
